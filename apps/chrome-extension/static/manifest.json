{
  "manifest_version": 3,
  "name": "Browser Research",
  "version": "0.4.0",
  "description": "Connect Chrome to Codex or Claude Code for read-only web research.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "offscreen", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Browser Research",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  }
}
